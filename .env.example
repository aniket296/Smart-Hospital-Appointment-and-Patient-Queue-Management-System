# Application Configuration
FLASK_ENV=development
SECRET_KEY=replace-with-strong-secret-key
JWT_SECRET_KEY=replace-with-strong-jwt-secret-key
JWT_EXPIRY_HOURS=8
HOSPITAL_TIMEZONE=Asia/Kolkata

# Database Configuration (MySQL 8.0+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hospital_queue_db
TEST_DB_NAME=hospital_queue_test_db

# Optional Direct SQLAlchemy URLs (override DB_* above if set)
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/hospital_queue_db
# TEST_DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/hospital_queue_test_db

# SMTP / Email Notification Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=noreply@hospital.test

# Frontend API Base URL (for Vite)
VITE_API_BASE_URL=http://127.0.0.1:5000/api
